{
  "name": "apontamento-producao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
    "build:shared": "pnpm --filter @apontamento/shared build",
    "dev:api": "pnpm --filter @apontamento/api dev",
    "dev:web": "pnpm --filter @apontamento/web dev",
    "migrate": "pnpm --filter @apontamento/api migrate",
    "seed": "pnpm --filter @apontamento/api seed",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm --filter @apontamento/web test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
