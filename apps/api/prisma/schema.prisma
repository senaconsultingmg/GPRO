// Modelo de dados — Fase 1: autenticação, auditoria, parâmetros e cadastros (seção 6).
// As tabelas de produção, estoque e manutenção entram nas fases seguintes.
// Todas as datas/horas (timestamptz) são gravadas em UTC.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  SUPERUSUARIO
  PCP
  APONTADOR
  LIDER
  ESTOQUE
  MATERIA_PRIMA
  MANUTENCAO
}

enum TipoMaquina {
  INJETORA
  SOPRADORA
  EXTRUSORA
}

enum TipoProduto {
  ACABADO
  SEMIACABADO
  MATERIA_PRIMA
  ADITIVO
  EXTRUSADO
  MOIDO
  RECICLADO
  MISTURA
}

enum Unidade {
  PECA
  KG
}

enum TipoEmbalagem {
  PALLET
  SACO
  GAIOLA
  CAIXOTE
  PILHA
  OUTRO
}

enum SituacaoFicha {
  RASCUNHO
  VIGENTE
  OBSOLETA
}

enum TipoLocalEstoque {
  PRODUTO_ACABADO
  MATERIA_PRIMA
}

enum ModalidadeTurno {
  CENTRAL
  REVEZAMENTO
}

enum TipoEtiqueta {
  PRODUTO
  EXTRUSAO
  MISTURA
  ENTRADA_MATERIA_PRIMA
  PERDA
  DEVOLUCAO_TRANSFERENCIA
}

enum TipoOrdem {
  PRODUCAO
  EXTRUSAO
}

enum SituacaoOrdem {
  ABERTA
  EM_PRODUCAO
  ENCERRADA
  CANCELADA
}

enum SituacaoRodada {
  PLANEJADA
  EM_ANDAMENTO
  ENCERRADA
}

enum SituacaoTurno {
  ABERTO
  FECHADO
  APROVADO
  APURADO
  EXPORTADO
}

enum TipoEvento {
  INICIO_MAQUINA
  FIM_MAQUINA
  PARADA
  REINICIO
  ENTRADA_MATERIA_PRIMA
  ENTRADA_SEMIACABADO
  SAIDA_PRODUCAO
  PERDA
  DEVOLUCAO_MATERIA_PRIMA
  TRANSFERENCIA
  BLOQUEIO_CAVIDADE
  DESBLOQUEIO_CAVIDADE
  SALDO_AVULSO_DEIXADO
  SALDO_AVULSO_RECEBIDO
}

enum MarcaHorario {
  NO_MOMENTO
  RETROATIVO
  ANTECIPADO
}

enum SituacaoEvento {
  VALIDO
  CORRECAO_PENDENTE
  INCORRETO
}

enum TipoAprovacao {
  CORRECAO
  HORARIO
  PESO
  JUSTIFICATIVA
  RELATORIO_TURNO
}

enum SituacaoAprovacao {
  PENDENTE
  APROVADA
  REJEITADA
}

enum SituacaoEtiqueta {
  EMITIDA
  RECEBIDA
  CONSUMIDA
  EXPORTADA
  CANCELADA
}

enum OrigemLote {
  COMPRA
  EXTRUSAO
  MISTURA
  MOIDO
  RECICLADO
}

enum TipoMovimento {
  ENTRADA_COMPRA
  ENTRADA_RETORNO
  ENTRADA_EXTRUSAO
  ENTRADA_MISTURA
  SAIDA_MISTURA
  CONSUMO_PRODUCAO
  DEVOLUCAO_PRODUCAO
  TRANSFERENCIA_LOCAL
  RECEBIMENTO_PRODUTO
  CONSUMO_SEMIACABADO
  ESTORNO_RECEBIMENTO
  ESTORNO_CORRECAO
  BAIXA_EXPORTACAO
}

enum TipoParametro {
  INTEIRO
  DECIMAL
  TEXTO
  BOOLEANO
  LISTA
}

// ---------------- Segurança ----------------

model Usuario {
  id                    String                    @id @default(uuid()) @db.Uuid
  nome                  String
  login                 String                    @unique
  senhaHash             String                    @map("senha_hash")
  perfis                Perfil[]
  equipeId              String?                   @map("equipe_id") @db.Uuid
  ativo                 Boolean                   @default(true)
  deveTrocarSenha       Boolean                   @default(false) @map("deve_trocar_senha")
  /// Manutenção: especialidades do técnico e marca de controlador (Fase 6).
  especialidades        EspecialidadeManutencao[] @default([])
  controladorManutencao Boolean                   @default(false) @map("controlador_manutencao")
  criadoEm              DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm          DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  equipe  Equipe?             @relation(fields: [equipeId], references: [id])
  sessoes SessaoDispositivo[]

  fichasCriadas         FichaTecnica[]     @relation("FichaCriadaPor")
  fichasAprovadas       FichaTecnica[]     @relation("FichaAprovadaPor")
  ordensCriadas         OrdemProducao[]
  rodadasCriadas        Rodada[]
  turnos                TurnoApontamento[]
  eventos               Evento[]
  aprovacoesSolicitadas Aprovacao[]        @relation("AprovacaoSolicitante")
  aprovacoesDecididas   Aprovacao[]        @relation("AprovacaoAprovador")
  importacoes           Importacao[]

  etiquetas       Etiqueta[]
  lotesCriados    LoteMaterial[]
  misturas        Mistura[]
  movimentos      MovimentoEstoque[]
  recebimentos    Recebimento[]
  impressoes      ImpressaoEtiqueta[]
  loteExportacaos LoteExportacao[]

  solicitacoesManutencao SolicitacaoManutencao[] @relation("SolicitacaoSolicitante")
  triagensManutencao     SolicitacaoManutencao[] @relation("SolicitacaoTriagem")
  ordensControladas      OrdemServico[]          @relation("OrdemControlador")
  ordensEncerradas       OrdemServico[]          @relation("OrdemEncerradaPor")
  etapasResponsavel      EtapaOrdemServico[]     @relation("EtapaResponsavel")
  etapasExecutadas       EtapaOrdemServico[]     @relation("EtapaExecutor")
  modelosSequencia       ModeloSequencia[]

  blocosEtiqueta   BlocoEtiqueta[]
  recusas          RecusaSincronizacao[] @relation("RecusaUsuario")
  recusasDecididas RecusaSincronizacao[] @relation("RecusaDecididoPor")
  alertasRelogio   AlertaRelogio[]

  @@map("usuario")
}

/// Sessão por dispositivo: guarda o token de renovação (somente o hash).
model SessaoDispositivo {
  id                 String    @id @default(uuid()) @db.Uuid
  usuarioId          String    @map("usuario_id") @db.Uuid
  dispositivo        String
  tokenRenovacaoHash String    @unique @map("token_renovacao_hash")
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoUsoEm        DateTime  @default(now()) @map("ultimo_uso_em") @db.Timestamptz(3)
  expiraEm           DateTime  @map("expira_em") @db.Timestamptz(3)
  revogadaEm         DateTime? @map("revogada_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, dispositivo])
  @@map("sessao_dispositivo")
}

model RegistroAuditoria {
  id            BigInt   @id @default(autoincrement())
  usuarioId     String?  @map("usuario_id") @db.Uuid
  usuarioLogin  String?  @map("usuario_login")
  dataHora      DateTime @default(now()) @map("data_hora") @db.Timestamptz(3)
  entidade      String
  entidadeId    String?  @map("entidade_id")
  acao          String
  valorAnterior Json?    @map("valor_anterior")
  valorNovo     Json?    @map("valor_novo")

  @@index([entidade, entidadeId])
  @@index([dataHora])
  @@map("registro_auditoria")
}

model ParametroSistema {
  chave           String        @id
  valor           String
  tipo            TipoParametro
  opcoes          String[]
  descricao       String
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  atualizadoPorId String?       @map("atualizado_por_id") @db.Uuid

  @@map("parametro_sistema")
}

// ---------------- Turnos e escala ----------------

model HorarioTurno {
  id                          String          @id @default(uuid()) @db.Uuid
  nome                        String          @unique
  modalidade                  ModalidadeTurno
  /// Hora local (America/Sao_Paulo) no formato HH:MM.
  horaInicio                  String          @map("hora_inicio")
  horaFim                     String          @map("hora_fim")
  /// 0 = domingo ... 6 = sábado.
  diasSemana                  Int[]           @map("dias_semana")
  /// Minutos de parada programada prevista no turno (ex.: refeição), descontados das horas disponíveis.
  paradaProgramadaPrevistaMin Int             @default(0) @map("parada_programada_prevista_min")
  ativo                       Boolean         @default(true)
  criadoEm                    DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm                DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  escalas Escala[]
  turnos  TurnoApontamento[]

  @@map("horario_turno")
}

model Equipe {
  id           String   @id @default(uuid()) @db.Uuid
  letra        String   @unique
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  usuarios Usuario[]
  escalas  Escala[]
  turnos   TurnoApontamento[]

  @@map("equipe")
}

model Escala {
  id             String   @id @default(uuid()) @db.Uuid
  /// Data civil do início do turno (turno da noite pertence à data em que começa).
  data           DateTime @db.Date
  horarioTurnoId String   @map("horario_turno_id") @db.Uuid
  equipeId       String   @map("equipe_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  horarioTurno HorarioTurno @relation(fields: [horarioTurnoId], references: [id])
  equipe       Equipe       @relation(fields: [equipeId], references: [id])

  @@unique([data, horarioTurnoId])
  @@map("escala")
}

// ---------------- Máquinas, moldes e produtos ----------------

model Maquina {
  id                           String      @id @default(uuid()) @db.Uuid
  codigo                       String      @unique
  descricao                    String
  tipo                         TipoMaquina
  ativa                        Boolean     @default(true)
  forcaFechamentoT             Float?      @map("forca_fechamento_t")
  distanciaColunasHorizontalMm Float?      @map("distancia_colunas_horizontal_mm")
  distanciaColunasVerticalMm   Float?      @map("distancia_colunas_vertical_mm")
  alturaMoldeMinMm             Float?      @map("altura_molde_min_mm")
  alturaMoldeMaxMm             Float?      @map("altura_molde_max_mm")
  pesoMaxMoldeKg               Float?      @map("peso_max_molde_kg")
  pressaoInjecaoBar            Float?      @map("pressao_injecao_bar")
  capacidadeInjecaoG           Float?      @map("capacidade_injecao_g")
  capacidadeKgH                Float?      @map("capacidade_kg_h")
  /// Lista de { nome, valor, unidade }.
  parametrosAdicionais         Json        @default("[]") @map("parametros_adicionais")
  criadoEm                     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm                 DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  fichas   FichaTecnica[]
  rodadas  Rodada[]
  turnos   MaquinaTurno[]
  divisoes DivisaoOp[]
  eventos  Evento[]

  solicitacoesManutencao SolicitacaoManutencao[]

  @@map("maquina")
}

model Molde {
  id               String   @id @default(uuid()) @db.Uuid
  codigo           String   @unique
  descricao        String
  larguraMm        Float    @map("largura_mm")
  comprimentoMm    Float    @map("comprimento_mm")
  alturaMm         Float    @map("altura_mm")
  pesoKg           Float    @map("peso_kg")
  numeroCavidades  Int      @map("numero_cavidades")
  forcaFechamentoT Float    @map("forca_fechamento_t")
  pressaoBar       Float    @map("pressao_bar")
  pesoInjetadoG    Float    @map("peso_injetado_g")
  /// Informado pelo usuário: o molde pode ser montado girado 90° entre as colunas.
  podeGirar        Boolean  @default(false) @map("pode_girar")
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cavidades CavidadeMolde[]
  fichas    FichaTecnica[]
  rodadas   Rodada[]

  @@map("molde")
}

model CavidadeMolde {
  id        String  @id @default(uuid()) @db.Uuid
  moldeId   String  @map("molde_id") @db.Uuid
  numero    Int
  produtoId String? @map("produto_id") @db.Uuid

  molde   Molde    @relation(fields: [moldeId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id])

  @@unique([moldeId, numero])
  @@map("cavidade_molde")
}

model Produto {
  id           String      @id @default(uuid()) @db.Uuid
  codigo       String      @unique
  descricao    String
  tipo         TipoProduto
  unidade      Unidade
  cor          String?
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  cavidades   CavidadeMolde[]
  conjuntos   ConjuntoPadrao[]
  fichas      FichaTecnica[]
  componentes ComponenteFicha[]
  ordens      OrdemProducao[]

  etiquetas  Etiqueta[]
  lotes      LoteMaterial[]
  movimentos MovimentoEstoque[]

  @@map("produto")
}

model ConjuntoPadrao {
  id            String        @id @default(uuid()) @db.Uuid
  produtoId     String        @map("produto_id") @db.Uuid
  tipoEmbalagem TipoEmbalagem @map("tipo_embalagem")
  quantidade    Float
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([produtoId, tipoEmbalagem])
  @@map("conjunto_padrao")
}

// ---------------- Ficha técnica (RN-02) ----------------

model FichaTecnica {
  id                 String        @id @default(uuid()) @db.Uuid
  produtoId          String        @map("produto_id") @db.Uuid
  /// Nulo na extrusão (produto + máquina).
  moldeId            String?       @map("molde_id") @db.Uuid
  maquinaId          String        @map("maquina_id") @db.Uuid
  versao             Int
  situacao           SituacaoFicha @default(RASCUNHO)
  cicloS             Float?        @map("ciclo_s")
  cavidades          Int
  phPadrao           Float         @map("ph_padrao")
  phCalculado        Boolean       @default(false) @map("ph_calculado")
  pesoPadraoG        Float?        @map("peso_padrao_g")
  toleranciaPesoPct  Float?        @map("tolerancia_peso_pct")
  /// Lista de { nome, valor, unidade } (temperaturas, pressões, tempos).
  parametrosProcesso Json          @default("[]") @map("parametros_processo")
  observacao         String?
  parecerReprovacao  String?       @map("parecer_reprovacao")
  criadoPorId        String        @map("criado_por_id") @db.Uuid
  aprovadorId        String?       @map("aprovador_id") @db.Uuid
  vigenteDesde       DateTime?     @map("vigente_desde") @db.Timestamptz(3)
  obsoletaEm         DateTime?     @map("obsoleta_em") @db.Timestamptz(3)
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto    Produto           @relation(fields: [produtoId], references: [id])
  molde      Molde?            @relation(fields: [moldeId], references: [id])
  maquina    Maquina           @relation(fields: [maquinaId], references: [id])
  criadoPor  Usuario           @relation("FichaCriadaPor", fields: [criadoPorId], references: [id])
  aprovador  Usuario?          @relation("FichaAprovadaPor", fields: [aprovadorId], references: [id])
  composicao ComponenteFicha[]
  rodadaOps  RodadaOp[]

  @@index([produtoId, moldeId, maquinaId])
  @@map("ficha_tecnica")
}

model ComponenteFicha {
  id              String @id @default(uuid()) @db.Uuid
  fichaId         String @map("ficha_id") @db.Uuid
  materialId      String @map("material_id") @db.Uuid
  consumoGPorPeca Float? @map("consumo_g_por_peca")
  percentual      Float?

  ficha    FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  material Produto      @relation(fields: [materialId], references: [id])

  @@unique([fichaId, materialId])
  @@map("componente_ficha")
}

// ---------------- Demais cadastros ----------------

model MotivoParada {
  id                        String   @id @default(uuid()) @db.Uuid
  codigo                    String   @unique
  descricao                 String
  programada                Boolean
  geraSolicitacaoManutencao Boolean  @default(false) @map("gera_solicitacao_manutencao")
  ativo                     Boolean  @default(true)
  criadoEm                  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm              DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("motivo_parada")
}

model TipoPerda {
  id              String   @id @default(uuid()) @db.Uuid
  descricao       String   @unique
  contaComoRefugo Boolean  @default(false) @map("conta_como_refugo")
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("tipo_perda")
}

model LocalEstoque {
  id           String           @id @default(uuid()) @db.Uuid
  nome         String           @unique
  tipo         TipoLocalEstoque
  ativo        Boolean          @default(true)
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  movimentosOrigem  MovimentoEstoque[] @relation("MovimentoOrigem")
  movimentosDestino MovimentoEstoque[] @relation("MovimentoDestino")
  recebimentos      Recebimento[]
  etiquetas         Etiqueta[]

  @@map("local_estoque")
}

model Impressora {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String   @unique
  enderecoIp   String   @map("endereco_ip")
  porta        Int      @default(9100)
  resolucaoDpi Int      @map("resolucao_dpi")
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  layouts LayoutEtiqueta[]

  impressoes ImpressaoEtiqueta[]

  @@map("impressora")
}

model LayoutEtiqueta {
  id                 String       @id @default(uuid()) @db.Uuid
  nome               String       @unique
  tipoEtiqueta       TipoEtiqueta @map("tipo_etiqueta")
  larguraMm          Float        @map("largura_mm")
  alturaMm           Float        @map("altura_mm")
  modeloZpl          String       @map("modelo_zpl")
  impressoraPadraoId String?      @map("impressora_padrao_id") @db.Uuid
  ativo              Boolean      @default(true)
  criadoEm           DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  impressoraPadrao Impressora? @relation(fields: [impressoraPadraoId], references: [id])

  impressoes ImpressaoEtiqueta[]

  @@map("layout_etiqueta")
}

/// Posto/dispositivo (tablet). O prefixo de 2 caracteres compõe o código das etiquetas (seção 8).
model Dispositivo {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String   @unique
  prefixo      String   @unique
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  sequencia SequenciaDispositivo?
  etiquetas Etiqueta[]
  blocos    BlocoEtiqueta[]

  @@map("dispositivo")
}

// ---------------- Produção (Fase 2) ----------------

/// Ordem de produção (RN-01). Número interno automático; número do ERP único (obrigatório na produção).
model OrdemProducao {
  id                 String        @id @default(uuid()) @db.Uuid
  numeroInterno      Int           @unique @default(autoincrement()) @map("numero_interno")
  numeroErp          String?       @unique @map("numero_erp")
  tipo               TipoOrdem
  produtoId          String        @map("produto_id") @db.Uuid
  quantidade         Float
  unidade            Unidade
  dataInicioPrevista DateTime?     @map("data_inicio_prevista") @db.Date
  dataFimPrevista    DateTime?     @map("data_fim_prevista") @db.Date
  observacao         String?
  situacao           SituacaoOrdem @default(ABERTA)
  origem             String        @default("DIGITACAO")
  criadoPorId        String        @map("criado_por_id") @db.Uuid
  encerradaEm        DateTime?     @map("encerrada_em") @db.Timestamptz(3)
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto   Produto     @relation(fields: [produtoId], references: [id])
  criadoPor Usuario     @relation(fields: [criadoPorId], references: [id])
  rodadaOps RodadaOp[]
  divisoes  DivisaoOp[]

  lotes LoteMaterial[]

  @@map("ordem_producao")
}

/// Rodada (RN-03): máquina + molde + OPs que rodam juntas.
model Rodada {
  id           String         @id @default(uuid()) @db.Uuid
  numero       Int            @unique @default(autoincrement())
  maquinaId    String         @map("maquina_id") @db.Uuid
  moldeId      String?        @map("molde_id") @db.Uuid
  situacao     SituacaoRodada @default(PLANEJADA)
  observacao   String?
  criadoPorId  String         @map("criado_por_id") @db.Uuid
  iniciadaEm   DateTime?      @map("iniciada_em") @db.Timestamptz(3)
  encerradaEm  DateTime?      @map("encerrada_em") @db.Timestamptz(3)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  maquina   Maquina        @relation(fields: [maquinaId], references: [id])
  molde     Molde?         @relation(fields: [moldeId], references: [id])
  criadoPor Usuario        @relation(fields: [criadoPorId], references: [id])
  ops       RodadaOp[]
  turnos    MaquinaTurno[]
  eventos   Evento[]

  @@index([maquinaId, situacao])
  @@map("rodada")
}

/// OP da rodada, com a versão da ficha técnica congelada e as cavidades atribuídas.
model RodadaOp {
  id             String @id @default(uuid()) @db.Uuid
  rodadaId       String @map("rodada_id") @db.Uuid
  ordemId        String @map("ordem_id") @db.Uuid
  fichaTecnicaId String @map("ficha_tecnica_id") @db.Uuid
  cavidades      Int[]

  rodada       Rodada        @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  ordem        OrdemProducao @relation(fields: [ordemId], references: [id])
  fichaTecnica FichaTecnica  @relation(fields: [fichaTecnicaId], references: [id])
  divisoes     DivisaoOp[]

  @@unique([rodadaId, ordemId])
  @@map("rodada_op")
}

model TurnoApontamento {
  id                    String        @id @default(uuid()) @db.Uuid
  apontadorId           String        @map("apontador_id") @db.Uuid
  data                  DateTime      @db.Date
  horarioTurnoId        String        @map("horario_turno_id") @db.Uuid
  equipeId              String        @map("equipe_id") @db.Uuid
  inicioNominal         DateTime      @map("inicio_nominal") @db.Timestamptz(3)
  fimNominal            DateTime      @map("fim_nominal") @db.Timestamptz(3)
  abertoEm              DateTime      @default(now()) @map("aberto_em") @db.Timestamptz(3)
  fechadoEm             DateTime?     @map("fechado_em") @db.Timestamptz(3)
  situacao              SituacaoTurno @default(ABERTO)
  dispositivo           String
  aprovadoEm            DateTime?     @map("aprovado_em") @db.Timestamptz(3)
  aprovadoPorId         String?       @map("aprovado_por_id") @db.Uuid
  apuradoEm             DateTime?     @map("apurado_em") @db.Timestamptz(3)
  apuradoPorId          String?       @map("apurado_por_id") @db.Uuid
  exportadoEm           DateTime?     @map("exportado_em") @db.Timestamptz(3)
  exportacaoId          String?       @map("exportacao_id") @db.Uuid
  /// Última devolução do PCP ao líder (divergência na apuração).
  devolvidoEm           DateTime?     @map("devolvido_em") @db.Timestamptz(3)
  /// Seção 11: o líder liberou continuar o turno em outro tablet (fila do anterior não enviada).
  trocaAparelhoLiberada Boolean       @default(false) @map("troca_aparelho_liberada")
  parecerDevolucao      String?       @map("parecer_devolucao")

  apontador    Usuario               @relation(fields: [apontadorId], references: [id])
  horarioTurno HorarioTurno          @relation(fields: [horarioTurnoId], references: [id])
  equipe       Equipe                @relation(fields: [equipeId], references: [id])
  maquinas     MaquinaTurno[]
  divisoes     DivisaoOp[]
  eventos      Evento[]
  aprovacoes   Aprovacao[]
  etiquetas    Etiqueta[]
  recusas      RecusaSincronizacao[]
  estadosFila  EstadoFilaAparelho[]

  @@index([apontadorId, situacao])
  @@map("turno_apontamento")
}

model MaquinaTurno {
  id                   String  @id @default(uuid()) @db.Uuid
  turnoId              String  @map("turno_id") @db.Uuid
  maquinaId            String  @map("maquina_id") @db.Uuid
  rodadaId             String  @map("rodada_id") @db.Uuid
  /// Definido no fechamento: a máquina segue rodando para o próximo turno.
  segueRodando         Boolean @default(false) @map("segue_rodando")
  /// Motivo da parada que estava aberta no fechamento (oferecida ao próximo turno).
  paradaAbertaMotivoId String? @map("parada_aberta_motivo_id") @db.Uuid

  turno   TurnoApontamento @relation(fields: [turnoId], references: [id])
  maquina Maquina          @relation(fields: [maquinaId], references: [id])
  rodada  Rodada           @relation(fields: [rodadaId], references: [id])

  @@unique([turnoId, maquinaId])
  @@map("maquina_turno")
}

/// Divisão da OP no turno (RN-04).
model DivisaoOp {
  id               String   @id @default(uuid()) @db.Uuid
  ordemId          String   @map("ordem_id") @db.Uuid
  rodadaOpId       String   @map("rodada_op_id") @db.Uuid
  sequencial       Int
  codigo           String   @unique
  turnoId          String   @map("turno_id") @db.Uuid
  maquinaId        String   @map("maquina_id") @db.Uuid
  horasDisponiveis Float    @map("horas_disponiveis")
  phReferencia     Float    @map("ph_referencia")
  meta             Float
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  /// Lote de exportação em que consumo, perdas e refugo da divisão foram enviados ao ERP.
  exportacaoId     String?  @map("exportacao_id") @db.Uuid

  ordem     OrdemProducao    @relation(fields: [ordemId], references: [id])
  rodadaOp  RodadaOp         @relation(fields: [rodadaOpId], references: [id])
  turno     TurnoApontamento @relation(fields: [turnoId], references: [id])
  maquina   Maquina          @relation(fields: [maquinaId], references: [id])
  eventos   Evento[]
  etiquetas Etiqueta[]
  lotes     LoteMaterial[]

  @@unique([ordemId, sequencial])
  @@unique([turnoId, rodadaOpId])
  @@map("divisao_op")
}

/// Lançamento imutável do apontador. Totais e indicadores são calculados a partir dos eventos.
model Evento {
  /// Identificador único gerado no dispositivo (evita duplicidade no reenvio).
  id              String         @id @db.Uuid
  tipo            TipoEvento
  turnoId         String         @map("turno_id") @db.Uuid
  maquinaId       String         @map("maquina_id") @db.Uuid
  rodadaId        String?        @map("rodada_id") @db.Uuid
  divisaoId       String?        @map("divisao_id") @db.Uuid
  horaOcorrencia  DateTime       @map("hora_ocorrencia") @db.Timestamptz(3)
  horaRegistro    DateTime       @map("hora_registro") @db.Timestamptz(3)
  recebidoEm      DateTime       @default(now()) @map("recebido_em") @db.Timestamptz(3)
  usuarioId       String         @map("usuario_id") @db.Uuid
  dispositivo     String
  dados           Json           @default("{}")
  /// Quantidade principal do evento (peças ou kg), para somas rápidas.
  quantidade      Float?
  marcaHorario    MarcaHorario   @default(NO_MOMENTO) @map("marca_horario")
  pesoNaoConforme Boolean        @default(false) @map("peso_nao_conforme")
  situacao        SituacaoEvento @default(VALIDO)
  corrigeEventoId String?        @map("corrige_evento_id") @db.Uuid
  justificativa   String?

  turno      TurnoApontamento   @relation(fields: [turnoId], references: [id])
  maquina    Maquina            @relation(fields: [maquinaId], references: [id])
  rodada     Rodada?            @relation(fields: [rodadaId], references: [id])
  divisao    DivisaoOp?         @relation(fields: [divisaoId], references: [id])
  usuario    Usuario            @relation(fields: [usuarioId], references: [id])
  aprovacoes Aprovacao[]
  etiquetas  Etiqueta[]
  movimentos MovimentoEstoque[]

  solicitacaoManutencao SolicitacaoManutencao?

  @@index([turnoId, maquinaId, horaOcorrencia])
  @@index([rodadaId, tipo])
  @@index([divisaoId, tipo])
  @@map("evento")
}

/// Pendências para o líder (Fase 2 só registra; a decisão vem na Fase 4).
model Aprovacao {
  id                String            @id @default(uuid()) @db.Uuid
  tipo              TipoAprovacao
  turnoId           String            @map("turno_id") @db.Uuid
  eventoId          String?           @map("evento_id") @db.Uuid
  descricao         String
  solicitanteId     String            @map("solicitante_id") @db.Uuid
  aprovadorId       String?           @map("aprovador_id") @db.Uuid
  situacao          SituacaoAprovacao @default(PENDENTE)
  parecer           String?
  criadoEm          DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  decididoEm        DateTime?         @map("decidido_em") @db.Timestamptz(3)
  /// Correção (RN-09): CORRIGIR ou ANULAR, justificativa e valores corretos propostos.
  correcaoTipo      String?           @map("correcao_tipo")
  justificativa     String?
  valoresCorrecao   Json?             @map("valores_correcao")
  eventoCorretivoId String?           @map("evento_corretivo_id") @db.Uuid

  turno       TurnoApontamento @relation(fields: [turnoId], references: [id])
  evento      Evento?          @relation(fields: [eventoId], references: [id])
  solicitante Usuario          @relation("AprovacaoSolicitante", fields: [solicitanteId], references: [id])
  aprovador   Usuario?         @relation("AprovacaoAprovador", fields: [aprovadorId], references: [id])

  @@index([turnoId, situacao])
  @@map("aprovacao")
}

/// Registro de cada importação de Excel (usuário, data, arquivo e resultado).
model Importacao {
  id          String   @id @default(uuid()) @db.Uuid
  layout      String
  arquivoNome String   @map("arquivo_nome")
  arquivo     Bytes
  usuarioId   String   @map("usuario_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  sucesso     Boolean
  linhas      Int
  criados     Int      @default(0)
  atualizados Int      @default(0)
  erros       Json     @default("[]")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("importacao")
}

/// Nome da coluna no arquivo para cada campo do sistema, por layout (seção 9).
model MapeamentoColuna {
  id     String @id @default(uuid()) @db.Uuid
  layout String
  campo  String
  coluna String

  @@unique([layout, campo])
  @@map("mapeamento_coluna")
}

// ---------------- Etiquetas, matéria-prima e estoque (Fase 3) ----------------

/// Último número de etiqueta emitido por posto (o prefixo vem do cadastro do dispositivo).
model SequenciaDispositivo {
  dispositivoId String @id @map("dispositivo_id") @db.Uuid
  ultimo        Int    @default(0)

  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])

  @@map("sequencia_dispositivo")
}

/// Etiqueta com código único (nunca reutilizado). Código de barras GS1-128.
model Etiqueta {
  id                 String           @id @default(uuid()) @db.Uuid
  codigo             String           @unique
  sequencia          Int
  dispositivoId      String           @map("dispositivo_id") @db.Uuid
  tipo               TipoEtiqueta
  produtoId          String           @map("produto_id") @db.Uuid
  quantidade         Float
  unidade            Unidade
  pesoKg             Float?           @map("peso_kg")
  loteId             String?          @map("lote_id") @db.Uuid
  eventoId           String?          @map("evento_id") @db.Uuid
  divisaoId          String?          @map("divisao_id") @db.Uuid
  turnoId            String?          @map("turno_id") @db.Uuid
  responsavelId      String           @map("responsavel_id") @db.Uuid
  emitidaEm          DateTime         @default(now()) @map("emitida_em") @db.Timestamptz(3)
  avulso             Boolean          @default(false)
  numeroNoLancamento Int?             @map("numero_no_lancamento")
  totalNoLancamento  Int?             @map("total_no_lancamento")
  situacao           SituacaoEtiqueta @default(EMITIDA)
  impressaoPendente  Boolean          @default(true) @map("impressao_pendente")
  reimpressoes       Int              @default(0)
  /// Local atual (produto recebido no estoque).
  localEstoqueId     String?          @map("local_estoque_id") @db.Uuid
  /// Campos impressos (origem, destino, operador, composição...).
  dados              Json             @default("{}")

  dispositivo        Dispositivo         @relation(fields: [dispositivoId], references: [id])
  produto            Produto             @relation(fields: [produtoId], references: [id])
  lote               LoteMaterial?       @relation(fields: [loteId], references: [id])
  evento             Evento?             @relation(fields: [eventoId], references: [id])
  divisao            DivisaoOp?          @relation(fields: [divisaoId], references: [id])
  turno              TurnoApontamento?   @relation(fields: [turnoId], references: [id])
  responsavel        Usuario             @relation(fields: [responsavelId], references: [id])
  localEstoque       LocalEstoque?       @relation(fields: [localEstoqueId], references: [id])
  impressoes         ImpressaoEtiqueta[]
  recebimentos       Recebimento[]
  exportacaoId       String?             @map("exportacao_id") @db.Uuid
  canceladaEm        DateTime?           @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento String?             @map("motivo_cancelamento")
  exportacao         LoteExportacao?     @relation(fields: [exportacaoId], references: [id])
  movimentos         MovimentoEstoque[]

  @@unique([dispositivoId, sequencia])
  @@index([tipo, situacao])
  @@map("etiqueta")
}

/// Cada envio à impressora (inclusive reimpressões e testes de layout).
model ImpressaoEtiqueta {
  id           String    @id @default(uuid()) @db.Uuid
  etiquetaId   String?   @map("etiqueta_id") @db.Uuid
  layoutId     String?   @map("layout_id") @db.Uuid
  impressoraId String?   @map("impressora_id") @db.Uuid
  usuarioId    String    @map("usuario_id") @db.Uuid
  segundaVia   Boolean   @default(false) @map("segunda_via")
  teste        Boolean   @default(false)
  sucesso      Boolean?
  mensagem     String?
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  concluidoEm  DateTime? @map("concluido_em") @db.Timestamptz(3)

  etiqueta   Etiqueta?       @relation(fields: [etiquetaId], references: [id])
  layout     LayoutEtiqueta? @relation(fields: [layoutId], references: [id])
  impressora Impressora?     @relation(fields: [impressoraId], references: [id])
  usuario    Usuario         @relation(fields: [usuarioId], references: [id])

  @@map("impressao_etiqueta")
}

/// Lote de material. O saldo é a soma dos movimentos.
model LoteMaterial {
  id                String     @id @default(uuid()) @db.Uuid
  numero            String     @unique
  materialId        String     @map("material_id") @db.Uuid
  origem            OrigemLote
  fornecedor        String?
  notaFiscal        String?    @map("nota_fiscal")
  loteFornecedor    String?    @map("lote_fornecedor")
  quantidadeInicial Float      @map("quantidade_inicial")
  indiceFluidez     Float?     @map("indice_fluidez")
  cor               String?
  ordemExtrusaoId   String?    @map("ordem_extrusao_id") @db.Uuid
  divisaoId         String?    @map("divisao_id") @db.Uuid
  observacao        String?
  criadoPorId       String     @map("criado_por_id") @db.Uuid
  criadoEm          DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)

  material      Produto             @relation(fields: [materialId], references: [id])
  ordemExtrusao OrdemProducao?      @relation(fields: [ordemExtrusaoId], references: [id])
  divisao       DivisaoOp?          @relation(fields: [divisaoId], references: [id])
  criadoPor     Usuario             @relation(fields: [criadoPorId], references: [id])
  etiquetas     Etiqueta[]
  movimentos    MovimentoEstoque[]
  mistura       Mistura?            @relation("MisturaGerada")
  componenteEm  ComponenteMistura[]

  @@map("lote_material")
}

model Mistura {
  id              String   @id @default(uuid()) @db.Uuid
  loteId          String   @unique @map("lote_id") @db.Uuid
  produtosDestino String[] @map("produtos_destino")
  responsavelId   String   @map("responsavel_id") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  lote        LoteMaterial        @relation("MisturaGerada", fields: [loteId], references: [id])
  responsavel Usuario             @relation(fields: [responsavelId], references: [id])
  componentes ComponenteMistura[]

  @@map("mistura")
}

model ComponenteMistura {
  id           String @id @default(uuid()) @db.Uuid
  misturaId    String @map("mistura_id") @db.Uuid
  loteId       String @map("lote_id") @db.Uuid
  quantidadeKg Float  @map("quantidade_kg")
  percentual   Float

  mistura Mistura      @relation(fields: [misturaId], references: [id], onDelete: Cascade)
  lote    LoteMaterial @relation(fields: [loteId], references: [id])

  @@map("componente_mistura")
}

/// Movimento de estoque. Saldo de um local = entradas (destino) − saídas (origem).
model MovimentoEstoque {
  id             String        @id @default(uuid()) @db.Uuid
  tipo           TipoMovimento
  produtoId      String        @map("produto_id") @db.Uuid
  loteId         String?       @map("lote_id") @db.Uuid
  etiquetaId     String?       @map("etiqueta_id") @db.Uuid
  localOrigemId  String?       @map("local_origem_id") @db.Uuid
  localDestinoId String?       @map("local_destino_id") @db.Uuid
  quantidade     Float
  eventoId       String?       @map("evento_id") @db.Uuid
  usuarioId      String        @map("usuario_id") @db.Uuid
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  observacao     String?

  produto      Produto       @relation(fields: [produtoId], references: [id])
  lote         LoteMaterial? @relation(fields: [loteId], references: [id])
  etiqueta     Etiqueta?     @relation(fields: [etiquetaId], references: [id])
  localOrigem  LocalEstoque? @relation("MovimentoOrigem", fields: [localOrigemId], references: [id])
  localDestino LocalEstoque? @relation("MovimentoDestino", fields: [localDestinoId], references: [id])
  evento       Evento?       @relation(fields: [eventoId], references: [id])
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([loteId])
  @@index([produtoId])
  @@map("movimento_estoque")
}

/// Recebimento de etiqueta no estoque (produto acabado/semiacabado) ou no setor de matéria-prima.
model Recebimento {
  id             String    @id @default(uuid()) @db.Uuid
  etiquetaId     String    @map("etiqueta_id") @db.Uuid
  localEstoqueId String    @map("local_estoque_id") @db.Uuid
  recebidoPorId  String    @map("recebido_por_id") @db.Uuid
  recebidoEm     DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(3)
  /// Estorno do recebimento (o registro é mantido).
  estornadoEm    DateTime? @map("estornado_em") @db.Timestamptz(3)
  estornadoPorId String?   @map("estornado_por_id") @db.Uuid
  motivoEstorno  String?   @map("motivo_estorno")

  etiqueta     Etiqueta     @relation(fields: [etiquetaId], references: [id])
  localEstoque LocalEstoque @relation(fields: [localEstoqueId], references: [id])
  recebidoPor  Usuario      @relation(fields: [recebidoPorId], references: [id])

  @@index([etiquetaId])
  @@map("recebimento")
}

// ---------------- Exportação para o ERP (Fase 4) ----------------

/// Lote de exportação: os arquivos podem ser gerados novamente pelo número.
model LoteExportacao {
  id        String   @id @default(uuid()) @db.Uuid
  numero    Int      @unique @default(autoincrement())
  usuarioId String   @map("usuario_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  turnos    Int      @default(0)
  resumo    Json     @default("{}")

  usuario   Usuario          @relation(fields: [usuarioId], references: [id])
  etiquetas Etiqueta[]
  itens     ItemExportacao[]

  @@map("lote_exportacao")
}

/// Linha exportada (instantâneo usado para gerar o arquivo de novo).
model ItemExportacao {
  id     String @id @default(uuid()) @db.Uuid
  loteId String @map("lote_id") @db.Uuid
  layout String
  ordem  Int
  dados  Json

  lote LoteExportacao @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@index([loteId, layout])
  @@map("item_exportacao")
}

// ---------- Fase 6: manutenção (RN-14) ----------

enum EspecialidadeManutencao {
  ELETRICA
  MECANICA
  HIDRAULICA
  FERRAMENTARIA
  SETUP
  PREDIAL
}

enum SituacaoSolicitacao {
  ABERTA
  EM_TRIAGEM
  CONVERTIDA
  RECUSADA
  ENCERRADA
}

enum TipoOrdemServico {
  CORRETIVA
  PREVENTIVA
}

enum SituacaoOrdemServico {
  ABERTA
  EM_EXECUCAO
  ENCERRADA
}

enum SituacaoEtapa {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

model SolicitacaoManutencao {
  id                  String              @id @default(uuid()) @db.Uuid
  numero              Int                 @unique @default(autoincrement())
  maquinaId           String?             @map("maquina_id") @db.Uuid
  /// Local digitado quando não há máquina (ex.: manutenção predial).
  local               String?
  /// Parada que gerou a solicitação (automática).
  eventoParadaId      String?             @unique @map("evento_parada_id") @db.Uuid
  descricao           String
  solicitanteId       String              @map("solicitante_id") @db.Uuid
  situacao            SituacaoSolicitacao @default(ABERTA)
  /// Hora da ocorrência (da parada) ou do registro manual; início do tempo até o atendimento.
  ocorridaEm          DateTime            @map("ocorrida_em") @db.Timestamptz(3)
  criadoEm            DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  triagemEm           DateTime?           @map("triagem_em") @db.Timestamptz(3)
  triagemPorId        String?             @map("triagem_por_id") @db.Uuid
  recusadaEm          DateTime?           @map("recusada_em") @db.Timestamptz(3)
  justificativaRecusa String?             @map("justificativa_recusa")

  maquina      Maquina?      @relation(fields: [maquinaId], references: [id])
  eventoParada Evento?       @relation(fields: [eventoParadaId], references: [id])
  solicitante  Usuario       @relation("SolicitacaoSolicitante", fields: [solicitanteId], references: [id])
  triagemPor   Usuario?      @relation("SolicitacaoTriagem", fields: [triagemPorId], references: [id])
  ordemServico OrdemServico?

  @@index([situacao])
  @@index([maquinaId, situacao])
  @@map("solicitacao_manutencao")
}

model OrdemServico {
  id               String               @id @default(uuid()) @db.Uuid
  numero           Int                  @unique @default(autoincrement())
  solicitacaoId    String               @unique @map("solicitacao_id") @db.Uuid
  tipo             TipoOrdemServico
  eletiva          Boolean              @default(false)
  situacao         SituacaoOrdemServico @default(ABERTA)
  /// Controlador que aprovou e responde pela OS.
  controladorId    String               @map("controlador_id") @db.Uuid
  criadoEm         DateTime             @default(now()) @map("criado_em") @db.Timestamptz(3)
  inicio           DateTime?            @db.Timestamptz(3)
  fim              DateTime?            @db.Timestamptz(3)
  servicoExecutado String?              @map("servico_executado")
  encerradaEm      DateTime?            @map("encerrada_em") @db.Timestamptz(3)
  encerradaPorId   String?              @map("encerrada_por_id") @db.Uuid

  solicitacao  SolicitacaoManutencao @relation(fields: [solicitacaoId], references: [id])
  controlador  Usuario               @relation("OrdemControlador", fields: [controladorId], references: [id])
  encerradaPor Usuario?              @relation("OrdemEncerradaPor", fields: [encerradaPorId], references: [id])
  etapas       EtapaOrdemServico[]

  @@map("ordem_servico")
}

model EtapaOrdemServico {
  id                        String                  @id @default(uuid()) @db.Uuid
  ordemServicoId            String                  @map("ordem_servico_id") @db.Uuid
  /// Etapas com a mesma ordem correm em paralelo.
  ordem                     Int
  descricao                 String
  especialidade             EspecialidadeManutencao
  responsavelId             String?                 @map("responsavel_id") @db.Uuid
  executorId                String?                 @map("executor_id") @db.Uuid
  situacao                  SituacaoEtapa           @default(PENDENTE)
  inicio                    DateTime?               @db.Timestamptz(3)
  fim                       DateTime?               @db.Timestamptz(3)
  servicoExecutado          String?                 @map("servico_executado")
  justificativaCancelamento String?                 @map("justificativa_cancelamento")
  criadoEm                  DateTime                @default(now()) @map("criado_em") @db.Timestamptz(3)

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id])
  responsavel  Usuario?     @relation("EtapaResponsavel", fields: [responsavelId], references: [id])
  executor     Usuario?     @relation("EtapaExecutor", fields: [executorId], references: [id])

  @@index([ordemServicoId, ordem])
  @@index([especialidade, situacao])
  @@map("etapa_ordem_servico")
}

/// Sequência de etapas reutilizável (ex.: troca de câmara quente).
model ModeloSequencia {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String   @unique
  descricao    String?
  /// [{ ordem, descricao, especialidade }]
  etapas       Json
  ativo        Boolean  @default(true)
  criadoPorId  String   @map("criado_por_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  criadoPor Usuario @relation(fields: [criadoPorId], references: [id])

  @@map("modelo_sequencia")
}

// ---------- Fase 7: offline e sincronização (seção 11) ----------

/// Faixa de números de etiqueta reservada por um tablet para usar sem conexão.
model BlocoEtiqueta {
  id            String   @id @default(uuid()) @db.Uuid
  /// Posto (dispositivo do cadastro) dono da sequência.
  dispositivoId String   @map("dispositivo_id") @db.Uuid
  /// Identificador do aparelho (tablet) que reservou.
  aparelho      String
  inicio        Int
  fim           Int
  usuarioId     String   @map("usuario_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  dispositivo Dispositivo @relation(fields: [dispositivoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([dispositivoId, inicio])
  @@map("bloco_etiqueta")
}

enum SituacaoRecusa {
  PENDENTE
  DESCARTADO
  RELANCADO
}

/// Lançamento que o servidor recusou na sincronização; nada é descartado em silêncio.
model RecusaSincronizacao {
  id                String         @id @default(uuid()) @db.Uuid
  /// Identificador do item da fila no tablet (reenvio do aviso não duplica).
  itemId            String         @unique @map("item_id") @db.Uuid
  turnoId           String?        @map("turno_id") @db.Uuid
  tipo              String
  rota              String
  corpo             Json
  status            Int
  mensagem          String
  /// Hora em que o lançamento foi feito no tablet.
  criadoEm          DateTime       @map("criado_em") @db.Timestamptz(3)
  recebidoEm        DateTime       @default(now()) @map("recebido_em") @db.Timestamptz(3)
  usuarioId         String         @map("usuario_id") @db.Uuid
  aparelho          String
  situacao          SituacaoRecusa @default(PENDENTE)
  decididoEm        DateTime?      @map("decidido_em") @db.Timestamptz(3)
  decididoPorId     String?        @map("decidido_por_id") @db.Uuid
  justificativa     String?
  eventoRelancadoId String?        @map("evento_relancado_id") @db.Uuid

  turno       TurnoApontamento? @relation(fields: [turnoId], references: [id])
  usuario     Usuario           @relation("RecusaUsuario", fields: [usuarioId], references: [id])
  decididoPor Usuario?          @relation("RecusaDecididoPor", fields: [decididoPorId], references: [id])

  @@index([situacao])
  @@map("recusa_sincronizacao")
}

/// Último estado da fila informado por um tablet para um turno.
model EstadoFilaAparelho {
  id           String   @id @default(uuid()) @db.Uuid
  aparelho     String
  turnoId      String   @map("turno_id") @db.Uuid
  pendentes    Int
  usuarioId    String   @map("usuario_id") @db.Uuid
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  turno TurnoApontamento @relation(fields: [turnoId], references: [id])

  @@unique([aparelho, turnoId])
  @@map("estado_fila_aparelho")
}

/// Relógio do tablet diferente do servidor além do parâmetro: alerta ao superusuário.
model AlertaRelogio {
  id           String   @id @default(uuid()) @db.Uuid
  aparelho     String   @unique
  usuarioId    String?  @map("usuario_id") @db.Uuid
  /// Diferença mais recente em segundos (positivo: tablet adiantado).
  diferencaSeg Int      @map("diferenca_seg")
  maiorSeg     Int      @map("maior_seg")
  ocorrencias  Int      @default(1)
  primeiraEm   DateTime @default(now()) @map("primeira_em") @db.Timestamptz(3)
  ultimaEm     DateTime @default(now()) @map("ultima_em") @db.Timestamptz(3)
  resolvido    Boolean  @default(false)

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("alerta_relogio")
}
