# Banco de dados
POSTGRES_USER=apontamento
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=apontamento
DATABASE_URL=postgresql://apontamento:troque-esta-senha@localhost:5432/apontamento

# Autenticação (gere um segredo longo e aleatório)
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
JWT_ACESSO_MINUTOS=15
RENOVACAO_DIAS=30

# Carrega os dados de exemplo na primeira subida
CARREGAR_DADOS_EXEMPLO=true

# Porta pública do sistema
PORTA_WEB=8080

# Agente de impressão (rede da fábrica)
AGENTE_TOKEN=troque-este-token
AGENTE_PORTAS=9100
PORTA_AGENTE=9180
# AGENTE_SIMULAR_DIR=/tmp/etiquetas   # simulação: grava ZPL em arquivos

# Backup diário do banco (serviço "backup")
BACKUP_HORA=02:00
RETENCAO_DIAS=14
BACKUP_PASTA=./backups

# Banco no Supabase (opcional): use com
#   docker compose -f docker-compose.yml -f docker-compose.supabase.yml up -d --build
# Session pooler (porta 5432), com SSL. Copie de Supabase → Connect → Session pooler.
# SUPABASE_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
